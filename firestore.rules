rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function adminDocExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function adminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    function adminActive() {
      // Missing `active` must default to true — accessing .active when undefined
      // aborts the whole rule with "Property active is undefined" (DENY).
      return adminDocExists()
        && (
          !('active' in adminDoc())
          || adminDoc().active != false
        );
    }

    /** Legacy marketplace ADMIN users (users.role) are treated as Super Admin. */
    function isLegacySuperAdmin() {
      return userExists() && userRole() == 'ADMIN';
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        isLegacySuperAdmin()
        || (
          adminActive()
          // Anything other than explicit staff is Super Admin (super_admin, ADMIN, missing).
          && adminDoc().role != 'staff'
        )
      );
    }

    function isActiveStaff() {
      return adminActive() && adminDoc().role == 'staff';
    }

    /** Any panel admin (super or active staff). */
    function isAdmin() {
      return isSuperAdmin() || isActiveStaff();
    }

    function hasPerm(perm) {
      return isSuperAdmin()
        || (
          isActiveStaff()
          && 'permissions' in adminDoc()
          && adminDoc().permissions is list
          && perm in adminDoc().permissions
        );
    }

    function canManageProperties() {
      return isSuperAdmin()
        || hasPerm('properties')
        || hasPerm('submissions')
        || hasPerm('reports');
    }

    /** Staff who process account deletion / retention cleanup. */
    function canPurgeData() {
      return isSuperAdmin() || hasPerm('deletion');
    }

    function isPublicRole(role) {
      return role in ['INDIVIDUAL', 'BUYER', 'HOUSE_OWNER', 'DEALER'];
    }

    function isValidUserRole(role) {
      return role in ['INDIVIDUAL', 'BUYER', 'HOUSE_OWNER', 'DEALER', 'SALES_REP', 'ADMIN'];
    }

    // —— User profiles (Firebase Auth UID) ——
    match /users/{userId} {
      // Owner picker (properties/dealers) + reports + deletion purge need list/read.
      allow read: if isOwner(userId)
        || hasPerm('users')
        || hasPerm('reports')
        || hasPerm('dealers')
        || canManageProperties()
        || canPurgeData()
        || isSuperAdmin();

      allow create: if isSignedIn()
        && (
          (
            request.auth.uid == userId
            && isPublicRole(request.resource.data.role)
          )
          || (
            hasPerm('users')
            && isValidUserRole(request.resource.data.role)
            && !(request.resource.data.role == 'ADMIN' && !isSuperAdmin())
          )
          // Admin Add Property → create owner/dealer profile on behalf of listing.
          || (
            canManageProperties()
            && isPublicRole(request.resource.data.role)
          )
        );

      allow update: if isSuperAdmin()
        || (
          hasPerm('users')
          && !(request.resource.data.role == 'ADMIN' && resource.data.role != 'ADMIN' && !isSuperAdmin())
        )
        || (
          isOwner(userId)
          && request.resource.data.role == resource.data.role
        )
        // Dealers module: demote DEALER → marketplace role after deleting agency.
        || (
          hasPerm('dealers')
          && resource.data.role == 'DEALER'
          && request.resource.data.role in ['INDIVIDUAL', 'BUYER', 'HOUSE_OWNER']
        );

      allow delete: if isOwner(userId) || hasPerm('users') || canPurgeData() || isSuperAdmin();
    }

    // Admin allow-list — own read for session; Super Admin may list/read for Staff UI via Admin SDK (writes client-blocked).
    match /admins/{adminId} {
      allow read: if isSignedIn() && (
        request.auth.uid == adminId
        || isSuperAdmin()
      );
      allow write: if false;
    }

    // —— Listings ——
    match /properties/{propertyId} {
      allow read: if true;

      // Owners: own draft/pending. Admins: any ownerUserId + any status (Publish Immediately).
      allow create: if canManageProperties()
        || (
          isSignedIn()
          && request.resource.data.ownerUserId == request.auth.uid
          && request.resource.data.status in ['DRAFT', 'PENDING_APPROVAL']
        );

      allow update: if canManageProperties()
        || (
          isSignedIn()
          && resource.data.ownerUserId == request.auth.uid
          && request.resource.data.ownerUserId == resource.data.ownerUserId
          && (
            request.resource.data.status in ['DRAFT', 'PENDING_APPROVAL']
            || (
              resource.data.status in ['PUBLISHED', 'RESERVED']
              && request.resource.data.status == resource.data.status
            )
          )
        );

      allow delete: if canManageProperties()
        || canPurgeData()
        || (
          isSignedIn()
          && resource.data.ownerUserId == request.auth.uid
        );
    }

    // —— Inquiries ——
    match /inquiries/{id} {
      allow create: if isSignedIn()
        && request.resource.data.buyerId == request.auth.uid;

      allow read: if hasPerm('inquiries') || hasPerm('reports') || canPurgeData() || isSuperAdmin()
        || (isSignedIn() && resource.data.buyerId == request.auth.uid);

      allow update: if hasPerm('inquiries') || isSuperAdmin();

      allow delete: if hasPerm('inquiries') || canPurgeData() || isSuperAdmin()
        || (isSignedIn() && resource.data.buyerId == request.auth.uid);
    }

    // —— Team (public read, admin write) ——
    match /teamMembers/{id} {
      allow read: if true;
      allow write: if hasPerm('team') || isSuperAdmin();
    }

    // —— Site settings (featured landing picks, etc.) ——
    match /siteSettings/{docId} {
      allow read: if true;
      allow write: if hasPerm('featured')
        || hasPerm('properties')
        || canManageProperties()
        || isSuperAdmin();
    }

    // —— Public lead forms (create only; no public read) ——
    match /contactMessages/{id} {
      allow create: if true;
      allow read, update, delete: if hasPerm('inquiries') || isSuperAdmin();
    }

    match /newsletterSignups/{id} {
      allow create: if true
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && (
          request.resource.data.keys().hasOnly(['email', 'subscribedAt'])
          || request.resource.data.keys().hasOnly(['email', 'createdAt'])
          || request.resource.data.keys().hasOnly(['email', 'subscribedAt', 'createdAt'])
        );
      allow read, update, delete: if hasPerm('newsletter') || isSuperAdmin();
    }

    // —— Account deletion ——
    match /deletionRequests/{id} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow read: if hasPerm('deletion') || isSuperAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if hasPerm('deletion') || isSuperAdmin();
    }

    // —— Dealers ——
    match /developers/{id} {
      allow read: if true;
      allow create: if hasPerm('dealers') || isSuperAdmin()
        || (
          isSignedIn()
          && request.resource.data.dealerUserId == request.auth.uid
        );
      allow update: if hasPerm('dealers') || canPurgeData() || isSuperAdmin()
        || (
          // Own commission rate only (Admin ↔ Dealer synced field).
          isSignedIn()
          && resource.data.dealerUserId == request.auth.uid
          && request.resource.data.dealerUserId == resource.data.dealerUserId
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['commissionRate', 'updatedAt'])
        )
        || (
          // Own profile resubmit — not commissionRate (handled above).
          isSignedIn()
          && resource.data.dealerUserId == request.auth.uid
          && request.resource.data.dealerUserId == resource.data.dealerUserId
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'companyName',
                'contactPerson',
                'registrationNumber',
                'status',
                'statusUpdatedAt',
                'statusHistory',
                'rejectionReason',
                'rejectionEmailSentAt',
                'rejectionEmailClaimedAt',
                'updatedAt',
              ])
        );
      allow delete: if hasPerm('dealers') || isSuperAdmin();
    }

    match /transactions/{id} {
      allow read: if hasPerm('reports') || canPurgeData() || isSuperAdmin()
        || (
          isSignedIn()
          && resource.data.developerId is string
          && exists(/databases/$(database)/documents/developers/$(resource.data.developerId))
          && get(/databases/$(database)/documents/developers/$(resource.data.developerId)).data.dealerUserId
            == request.auth.uid
        );
      allow create, delete: if isSuperAdmin();
      allow update: if canPurgeData() || isSuperAdmin()
        || (
          isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dealerDeleted'])
          && request.resource.data.dealerDeleted == true
          && resource.data.developerId is string
          && exists(/databases/$(database)/documents/developers/$(resource.data.developerId))
          && get(/databases/$(database)/documents/developers/$(resource.data.developerId)).data.dealerUserId
            == request.auth.uid
        );
    }
  }
}
