rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // DEV / early launch — tighten with Firebase Auth + admin claims before public scale.
    match /teamMembers/{id} {
      allow read, write: if true;
    }
    match /properties/{id} {
      allow read, write: if true;
    }
    match /inquiries/{id} {
      allow read, write: if true;
    }
    match /contactMessages/{id} {
      allow read, write: if true;
    }
    match /newsletterSignups/{id} {
      allow read, write: if true;
    }
  }
}
