rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // User profiles — keyed by Firebase Auth UID.
    // TODO: restrict admin delete/list to custom claims before public scale.
    match /users/{userId} {
      allow read: if isSignedIn();
      // Self-registration uses own UID; admin may create profile stubs for assigned owners.
      allow create: if isSignedIn();
      allow update: if isOwner(userId) || isSignedIn();
      allow delete: if isSignedIn();
    }

    // Listings — public read; authenticated writes (owner scoping enforced in app layer).
    // TODO: tighten create to request.resource.data.ownerUserId == request.auth.uid
    // and admin moderation via custom claims.
    match /properties/{propertyId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /inquiries/{id} {
      allow read, write: if isSignedIn();
    }

    match /teamMembers/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /contactMessages/{id} {
      allow create: if true;
      allow read, update, delete: if isSignedIn();
    }

    match /newsletterSignups/{id} {
      allow create: if true;
      allow read, update, delete: if isSignedIn();
    }

    // Account deletion requests — signed-in users can create; admins process via app.
    // TODO: restrict list/update/delete to admin custom claims before public scale.
    match /deletionRequests/{id} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isSignedIn();
    }

    // Optional dealer / commission collections (flagged on account deletion).
    match /developers/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /transactions/{id} {
      allow read, write: if isSignedIn();
    }
  }
}
