# Copy to .env.local and fill in values.
# cp .env.local.example .env.local

# Mapbox GL — free public token from https://account.mapbox.com/access-tokens/
# Required for the Residences map view (/map) and property mini-maps.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# Firebase / Firestore (Project settings → Your apps → Web app config)
# Find these in Firebase Console → Project settings → General → Your apps → SDK setup and configuration.
# Used for inquiries/leads (and newsletter) in this phase. Properties/users/team stay mock unless otherwise wired.
# TODO: lock down Firestore security rules before production (open rules are demo-only).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional (Analytics)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
