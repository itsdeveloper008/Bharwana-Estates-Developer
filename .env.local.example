# Copy to .env.local and fill in values.
# cp .env.local.example .env.local

# Google Maps — required for /map, listing pin picker, and place search
# Enable for this key: Maps JavaScript API + Places API + Geocoding API
# https://console.cloud.google.com/google/maps-apis
# If the key uses API restrictions, allowlist those three APIs.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Firebase / Firestore (Project settings → Your apps → Web app config)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Google Sign-In web client (Project settings → Your apps, or Google Cloud → Credentials)
# Same value as the OAuth 2.0 Web client Firebase creates for this project.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=

# ── Firebase Admin SDK (server-only — Staff create/disable/delete) ──────────
# GCP Console → IAM → Service Accounts → create key (JSON).
# Roles: Firebase Authentication Admin + Cloud Datastore User (or Firebase Admin).
# Vercel: add these for Production (and Preview if needed), then redeploy.
# PRIVATE_KEY: paste PEM with literal \n for newlines, or multi-line in Vercel UI.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Public site URL (auth continue links + rejection email CTAs)
NEXT_PUBLIC_SITE_URL=https://bharwanaestates.com

# Resend — listing / dealer rejection emails (Vercel env + redeploy)
# https://resend.com → API key + verified domain from-address
RESEND_API_KEY=
RESEND_FROM_EMAIL=Bharwana Estates <noreply@your-verified-domain.com>
# Optional BCC copy of rejection emails
RESEND_REJECTION_BCC=info@bharwanaestates.com
