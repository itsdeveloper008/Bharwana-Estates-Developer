# Copy to .env.local and fill in values.
# cp .env.local.example .env.local

# Google Maps JavaScript API — required for /map (roadmap / satellite / hybrid / terrain)
# https://console.cloud.google.com/google/maps-apis
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional Mapbox token — address geocoding in the property form pin picker
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# Firebase / Firestore (Project settings → Your apps → Web app config)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
