rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function adminDocExists() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    function adminDoc() {
      return firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data;
    }

    function adminActive() {
      // Missing `active` must default to true — reading .active when undefined DENYs.
      return adminDocExists()
        && (
          !('active' in adminDoc())
          || adminDoc().active != false
        );
    }

    function isAdmin() {
      return isSignedIn()
        && (
          (
            firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
            && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'ADMIN'
          )
          || adminActive()
        );
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 10 * 1024 * 1024;
    }

    // Listing photos — path includes uploader uid (set by client).
    // Admins may also write under another user's prefix when creating on their behalf.
    match /listings/{userId}/{propertyId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn()
        && isImage()
        && (request.auth.uid == userId || isAdmin());
      allow delete: if isSignedIn()
        && (request.auth.uid == userId || isAdmin());
    }

    // Team headshots — any active admin / staff (client path; Admin API also uploads).
    match /team/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isImage();
      allow delete: if isAdmin();
    }

    // Legacy listing path under team/listings — read OK; no new public writes.
    match /team/listings/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isImage();
      allow delete: if isAdmin();
    }
  }
}
