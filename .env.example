# Mapbox GL — free public token from https://account.mapbox.com/access-tokens/
# Required for /map and property mini-maps. Leave blank to show the token fallback UI.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Firebase / Firestore (Project settings → Your apps → Web app config)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional (Analytics)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── Firebase Admin SDK (server-only — Staff create/disable/delete) ──────────
# Setup:
# 1. Google Cloud Console → project bharwana-estate-developer → IAM & Admin → Service Accounts
# 2. Create a service account (or use the Firebase Admin SDK service account).
# 3. Grant roles on that service account (same GCP project as the Firebase app):
#    - Cloud Datastore User  (required for Admin SDK Firestore reads/writes)
#    - Firebase Authentication Admin  (required for createUser / disable / delete)
#    - Service Account Token Creator (recommended)
# 4. Keys → Add key → JSON → download.
# 5. Map JSON fields to env vars below — all three MUST come from the SAME JSON file:
#      project_id  → FIREBASE_ADMIN_PROJECT_ID  (must equal NEXT_PUBLIC_FIREBASE_PROJECT_ID)
#      client_email → FIREBASE_ADMIN_CLIENT_EMAIL
#      private_key  → FIREBASE_ADMIN_PRIVATE_KEY
# 6. For FIREBASE_ADMIN_PRIVATE_KEY: paste the full PEM including
#    -----BEGIN PRIVATE KEY----- … -----END PRIVATE KEY-----
#    Prefer keeping newlines escaped as the two characters \n (one line in Vercel),
#    or use Vercel’s multiline editor. Do not wrap the value in extra quotes.
#    The app normalizes \\n → real newlines and strips wrapping quotes if present.
# 7. After adding/changing these vars, redeploy Production so the new values load.
# Local: copy the same three vars into .env.local (gitignored), then restart `next dev`.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Public site URL (password-reset continue links + rejection email CTAs)
NEXT_PUBLIC_SITE_URL=https://bharwanaestates.com

# ── Resend (transactional email — listing / dealer rejection notices) ─────────
# 1. Create an account at https://resend.com and verify your sending domain
#    (or use onboarding@resend.dev for sandbox tests only).
# 2. API Keys → Create → copy the key.
# 3. Vercel → Project → Settings → Environment Variables → add for Production
#    (and Preview if you test there), then redeploy.
# Local: add the same vars to .env.local and restart `next dev`.
# Rejection emails are skipped silently when Resend is unset or the user only
# has a phone-synthetic email (@phone.bharwana.local).
# Email failures never block the reject action (Firestore + in-app badge still commit).
RESEND_API_KEY=
RESEND_FROM_EMAIL=Bharwana Estates <noreply@your-verified-domain.com>
# Optional BCC copy of every rejection email (admin audit trail)
RESEND_REJECTION_BCC=info@bharwanaestates.com
