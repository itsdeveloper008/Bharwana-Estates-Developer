# Mapbox GL — free public token from https://account.mapbox.com/access-tokens/
# Required for /map and property mini-maps. Leave blank to show the token fallback UI.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Firebase / Firestore (Project settings → Your apps → Web app config)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional (Analytics)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── Firebase Admin SDK (server-only — Staff create/disable/delete) ──────────
# Setup:
# 1. Google Cloud Console → project bharwana-estate-developer → IAM & Admin → Service Accounts
# 2. Create a service account (or use the Firebase Admin SDK service account).
# 3. Grant roles: Firebase Authentication Admin + Cloud Datastore User (or Firebase Admin).
# 4. Keys → Add key → JSON → download.
# 5. Map JSON fields to env vars below (Vercel → Settings → Environment Variables → Production).
# 6. For FIREBASE_ADMIN_PRIVATE_KEY, paste the full PEM and keep \n escaped as the two chars \n
#    (or paste multi-line in Vercel’s UI). Never commit the JSON key file.
# Local: copy the same three vars into .env.local (gitignored), then restart `next dev`.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
